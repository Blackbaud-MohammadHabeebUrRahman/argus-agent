# Argus — Environment Variables
# Copy to .env and fill in values. .env is .gitignored and auto-loaded by
# the investigate and evals CLIs.

# --------------- General ---------------
ARGUS_ENVIRONMENT=dev          # dev | stg | prd
ARGUS_CONFIG_PATH=config/argus.yaml
ARGUS_LOG_LEVEL=INFO

# --------------- Redis ---------------
ARGUS_REDIS_URL=redis://localhost:6379/1

# --------------- Teams (primary alert channel) ---------------
ARGUS_TEAMS_WEBHOOK_URL=

# --------------- Slack ---------------
ARGUS_SLACK_WEBHOOK_URL=

# --------------- Email ---------------
ARGUS_SMTP_HOST=
ARGUS_SMTP_PORT=587
ARGUS_SMTP_USER=
ARGUS_SMTP_PASSWORD=
ARGUS_EMAIL_FROM=argus@example.com

# --------------- Splunk (stub until credentials available) ---------------
ARGUS_SPLUNK_BASE_URL=
ARGUS_SPLUNK_TOKEN=

# --------------- GitHub ---------------
ARGUS_GITHUB_TOKEN=
ARGUS_GITHUB_ORG=blackbaud

# --------------- Claude API ---------------
# Standard variable the Anthropic SDK reads by default.
ANTHROPIC_API_KEY=
# Mirrored into ArgusSettings. Same value — kept for explicit namespacing.
ARGUS_ANTHROPIC_API_KEY=
# REQUIRED when the key starts with sk-ant-usr- (user-scoped key).
# Not needed when the key starts with sk-ant-api- (workspace-scoped key).
# Find your workspace id in the Anthropic console under Settings → Workspaces.
ANTHROPIC_WORKSPACE_ID=
