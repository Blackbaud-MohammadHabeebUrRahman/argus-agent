# Saboten Sentinel — Environment Variables
# Copy to .env and fill in values.

# --------------- General ---------------
SENTINEL_ENVIRONMENT=dev          # dev | stg | prd
SENTINEL_CONFIG_PATH=config/sentinel.yaml
SENTINEL_LOG_LEVEL=INFO

# --------------- Redis ---------------
SENTINEL_REDIS_URL=redis://localhost:6379/1

# --------------- Teams (primary alert channel) ---------------
SENTINEL_TEAMS_WEBHOOK_URL=

# --------------- Slack ---------------
SENTINEL_SLACK_WEBHOOK_URL=

# --------------- Email (Phase 2) ---------------
SENTINEL_SMTP_HOST=
SENTINEL_SMTP_PORT=587
SENTINEL_SMTP_USER=
SENTINEL_SMTP_PASSWORD=
SENTINEL_EMAIL_FROM=saboten-sentinel@blackbaud.com

# --------------- Splunk (stub until credentials available) ---------------
SENTINEL_SPLUNK_BASE_URL=
SENTINEL_SPLUNK_TOKEN=

# --------------- GitHub (Phase 2) ---------------
SENTINEL_GITHUB_TOKEN=
SENTINEL_GITHUB_ORG=blackbaud

# --------------- Claude API (Phase 2) ---------------
SENTINEL_ANTHROPIC_API_KEY=
